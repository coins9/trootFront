# T:ROOT 소셜 로그인 키 (실제 값은 .env 에 넣고 절대 커밋하지 않는다)
# 사용법: cp .env.example .env 후 값 채우기

# Google Cloud Console > OAuth 2.0 클라이언트 ID
# iOS 클라이언트 (GoogleService plist 의 CLIENT_ID)
GOOGLE_IOS_CLIENT_ID=
# iOS URL 스킴 (GoogleService plist 의 REVERSED_CLIENT_ID)
GOOGLE_IOS_URL_SCHEME=
# 웹 클라이언트 — Android 로그인 및 백엔드 idToken 검증용
GOOGLE_WEB_CLIENT_ID=

# Kakao Developers > 내 애플리케이션 > 네이티브 앱 키
KAKAO_NATIVE_APP_KEY=
